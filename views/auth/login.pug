extends ../layout.pug 

block content 
    h1.d-flex.justify-content-center.text-center.mt-5.display-1 Fotaza JCR
    .container.d-flex.justify-content-center.mt-5

        .card.p-4(style="width: 400px;")

            h1.text-center.mb-4 Iniciar Sesión

            if alert
                .alert.alert-danger.text-center #{alert.text}

            form(action="/login" method="POST")

                .mb-3
                    label.form-label Usuario
                    input.form-control.border-secondary(type="text" name="email")

                .mb-3
                    label.form-label Contraseña
                    input.form-control.border-secondary(type="password" name="password")

                button.btn.btn-primary.w-100(type="submit")
                    | Ingresar
                text ¿No tenes cuenta? 
                a(href='/register') Registrarse