extends ../layout.pug 

block content 
    .container.d-flex.justify-content-center.mt-5

        
        .card.p-4.position-relative(style="width: 400px;")


            a.btn.btn-outline-secondary.btn-sm.px-2.py-0.position-absolute.top-0.start-0.m-1(href="/") ← Volver

            h1.text-center.mb-4 Registrarse

            form(action="/register" method="POST")

                .mb-3
                    label.form-label Usuario
                    input.form-control.border-secondary(type="text" name="user")

                .mb-3
                    label.form-label Email
                    input.form-control.border-secondary(type="text" name="email")

                .mb-3
                    label.form-label Contraseña
                    input.form-control.border-secondary(type="password" name="password")

                .mb-3
                    label.form-label Repetir contraseña
                    input.form-control.border-secondary(type="password" name="password2")

                .mb-3
                    label.form-label Apellido
                    input.form-control.border-secondary(type="text" name="lastName")

                .mb-3
                    label.form-label Nombre
                    input.form-control.border-secondary(type="text" name="name")

                button.btn.btn-primary.w-100(type="submit")
                    | Registrarse