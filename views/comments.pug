extends layout.pug 

block content 
    nav.navbar.navbar-expand-lg.bg-primary.container-fluid

        a.navbar-brand(href="/home") Fotaza
            button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation")
                span.navbar-toggler-icon

        #navbarSupportedContent.collapse.navbar-collapse
            ul.navbar-nav.me-auto.mb-2.mb-lg-0
                li.nav-item
                    a.nav-link.active(aria-current="page" href="/home") Inicio
                li.nav-item
                    a.nav-link.active(href="/profile") Perfil
                li.nav-item.dropdown
                    a.nav-link.dropdown-toggle.active(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false") Imagenes
                    ul.dropdown-menu
                        li
                            a.dropdown-item(href="#") Con copyright
                        li
                            a.dropdown-item(href="#") Sin copyright
                li.nav-item
                    a.btn.btn-outline-light.bg-primary(href="/post/create") + Nueva Publicación

        form.d-flex.me-3(role="search")
            input.form-control.me-3(type="search" placeholder="Buscar" aria-label="Buscar")

    .container.d-flex.justify-content-center.mt-5

        .card.p-4.position-relative(style="width: 400px;")

            a.btn.btn-outline-secondary.btn-sm.px-2.py-0.position-absolute.top-0.start-0.m-1(href="/home") ← Volver

            h1.text-center.mb-4 Comentarios
                .border.rounded.p-2.mb-3(style="height: 300px; overflow-y: auto;")
                    if comments && comments.length > 0
                        each comment in comments
                            .d-flex.flex-column.mb-2
                                .d-flex.justify-content-between
                                    small(style="font-size: 1rem;") #{comment.User.userName}
                                    small.text-muted(style="font-size: 0.7rem;") #{new Date(comment.createdAt).toLocaleDateString('es-AR')} #{new Date(comment.createdAt).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })}
                                    if comment.idUser === currentUser.id || publicationAuthorId === currentUser.id
                                        a.text-danger(style="font-size: 0.7rem;" href=`/comments/delete/${comment.idComment}`) Eliminar
                                small.mb-0(style="font-size: 1.2rem;") #{comment.content}
                                hr
                    else
                        p.text-center.text-muted No hay comentarios aún.

                form(action=`/comments/${publicationId}` method="POST")
                    .mb-2
                        textarea.form-control(
                            name="content"
                            rows="3"
                            placeholder=pub && pub.commentsOpen ? "Escribí un comentario..." : "Los comentarios están deshabilitados."
                            disabled=pub && !pub.commentsOpen
                        )
                    button.btn.btn-primary.w-100(type="submit" disabled=pub && !pub.commentsOpen) Comentar
                                    
            
            