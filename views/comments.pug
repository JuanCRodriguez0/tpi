extends layout.pug 

block content 
    nav.navbar.navbar-expand-lg.bg-primary.container-fluid

        a.navbar-brand.ms-3(href="/home") Fotaza
            button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation")
                span.navbar-toggler-icon

        #navbarSupportedContent.collapse.navbar-collapse
            ul.navbar-nav.me-auto.mb-2.mb-lg-0.gap-3
                li.nav-item
                    a.nav-link.active(aria-current="page" href="/home") Inicio
                li.nav-item
                    a.nav-link.active(href="/profile") Perfil
                li.nav-item
                    a.btn.btn-outline-light.bg-primary(href="/post/create") + Nueva Publicación

        .position-relative.me-3
            input#searchInput.form-control(type="search" placeholder="Buscar usuario o #tag" autocomplete="off" style="width:250px;")
            #searchDropdown.position-absolute.bg-white.border.rounded.shadow(style="display:none; z-index:1000; width:100%; top:100%;")
        
        form(action="/logout" method="POST")
            button.btn.btn-danger.me-3(type="submit") Cerrar sesión

    .container.d-flex.justify-content-center.mt-5

        .card.p-4.position-relative(style="width: 800px;")

            a.btn.btn-outline-secondary.btn-sm.px-2.py-0.position-absolute.top-0.start-0.m-1(href="/home") ← Volver

            h1.text-center.mb-4 Comentarios

            .d-flex.gap-4
                .d-flex.align-items-center.justify-content-center(style="width: 350px; min-width: 350px;")
                    if pub.Images && pub.Images.length === 1
                        img.img-fluid(
                            src=`data:image/jpeg;base64,${pub.Images[0].image.toString('base64')}`
                            style="max-height: 400px; object-fit: contain;"
                        )
                    else if pub.Images && pub.Images.length > 1
                        #carouselComentarios.carousel.slide(style="width: 350px;")
                            .carousel-indicators
                                each img, index in pub.Images
                                    button(
                                        type="button"
                                        data-bs-target="#carouselComentarios"
                                        data-bs-slide-to=`${index}`
                                        class=index === 0 ? 'active' : ''
                                    )
                            .carousel-inner
                                each img, index in pub.Images
                                    div(class=`carousel-item ${index === 0 ? 'active' : ''}`)
                                        img.d-block.w-100(
                                            src=`data:image/jpeg;base64,${img.image.toString('base64')}`
                                            style="max-height: 400px; object-fit: contain;"
                                        )
                            button.carousel-control-prev(type="button" data-bs-target="#carouselComentarios" data-bs-slide="prev")
                                span.carousel-control-prev-icon
                            button.carousel-control-next(type="button" data-bs-target="#carouselComentarios" data-bs-slide="next")
                                span.carousel-control-next-icon

                .d-flex.flex-column.flex-grow-1
                    .border.rounded.p-2.mb-3(style="height: 300px; overflow-y: auto;")
                        if comments && comments.length > 0
                            each comment in comments
                                .d-flex.flex-column.mb-2
                                    .d-flex.justify-content-between
                                        small(style="font-size: 1rem;") #{comment.User.userName}
                                        small.text-muted(style="font-size: 0.7rem;") #{new Date(comment.createdAt).toLocaleDateString('es-AR')} #{new Date(comment.createdAt).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })}
                                        if comment.idUser === currentUser.idUser || publicationAuthorId === currentUser.idUser
                                            a.text-danger(style="font-size: 0.7rem;" href=`/comments/delete/${comment.idComment}`) Eliminar
                                    small.mb-0(style="font-size: 1.2rem;") #{comment.content}
                                    hr
                        else
                            p.text-center.text-muted No hay comentarios aún.

                    form(action=`/comments/${publicationId}` method="POST")
                        .mb-2
                            textarea.form-control(
                                name="content"
                                rows="3"
                                placeholder=pub && pub.commentsOpen ? "Escribí un comentario..." : "Los comentarios están deshabilitados."
                                disabled=pub && !pub.commentsOpen
                            )
                        button.btn.btn-primary.w-100(type="submit" disabled=pub && !pub.commentsOpen) Comentar
                                    
            
block scripts
    script(src="/search.js")