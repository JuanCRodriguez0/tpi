extends layout.pug

block content
    nav.navbar.bg-primary.container-fluid.d-flex.justify-content-between.align-items-center.px-4
        a.navbar-brand(href="/") Fotaza
        a.btn.btn-outline-light(href="/login") Iniciar sesión

    .container.mt-4
        h5.mb-3.text-center Contenido público
        .row.justify-content-center
            if publications && publications.length > 0
                each pub in publications
                    .col-12.col-md-6.col-lg-4
                        .card.mb-4(style="height: 500px; overflow: hidden;")
                            .card-header
                                strong #{pub.User.userName}
                            .card-body.d-flex.flex-column
                                h5.card-title #{pub.title}
                                if pub.description
                                    p.card-text #{pub.description}
                                if pub.Images && pub.Images.length > 0
                                    img.img-fluid.w-100(
                                        src=`data:image/jpeg;base64,${pub.Images[0].image.toString('base64')}`
                                        style="max-height: 300px; object-fit: contain;"
                                    )
                            .card-footer.text-muted
                                small #{new Date(pub.createdAt).toLocaleDateString('es-AR')} - #{new Date(pub.createdAt).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })}
            else
                .text-center.mt-5
                    p No hay contenido público disponible.