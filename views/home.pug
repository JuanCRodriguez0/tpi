extends layout.pug

block content

    nav.navbar.navbar-expand-lg.bg-primary.container-fluid

        a.navbar-brand.ms-3(href="/home") Fotaza
            button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation")
                span.navbar-toggler-icon

        #navbarSupportedContent.collapse.navbar-collapse
            ul.navbar-nav.me-auto.mb-2.mb-lg-0.gap-3
                li.nav-item
                    a.nav-link.active(aria-current="page" href="/home") 🏠 Inicio
                li.nav-item
                    a.nav-link.active(href="/profile") 👤 Perfil
                li.nav-item
                    a.btn.btn-outline-light.bg-primary(href="/post/create") 📷 Nueva Publicación

            h3.flex-grow-1.text-center Bienvenido, #{currentUser.userName}

        .position-relative.me-3
            input#searchInput.form-control(type="search" placeholder="Buscar usuario o #tag" autocomplete="off" style="width:250px;")
            #searchDropdown.position-absolute.bg-white.border.rounded.shadow(style="display:none; z-index:1000; width:100%; top:100%;")
        
        form(action="/logout" method="POST")
            button.btn.btn-danger.me-3(type="submit") ➜] Cerrar sesión

    .container.mt-4
        .row.justify-content-center
            if publications && publications.length > 0
                each pub in publications
                    .col-10
                        .card.mb-4
                            - const carouselId = `carousel-${pub.idPublication}`
                            .card-header.d-flex.justify-content-between.align-items-center
                                    h2 #{pub.User.userName}
                                    .dropdown
                                        a.btn.btn-link.text-dark.text-decoration-none.px-2.py-1.fs-5(type="button" data-bs-toggle="dropdown" )
                                            |•••
                                        ul.dropdown-menu.dropdown-menu-end
                                            if pub.idUser === currentUser.idUser
                                                li
                                                    if pub.commentsOpen
                                                        button.dropdown-item.comments-btn(
                                                            type="button"
                                                            data-publication=pub.idPublication
                                                            data-open="true"
                                                        ) ✉️ Cerrar comentarios
                                                    else
                                                        button.dropdown-item.comments-btn(
                                                            type="button"
                                                            data-publication=pub.idPublication
                                                            data-open="false"
                                                        ) 📩 Abrir comentarios
                                                li
                                                    a.dropdown-item(href="#" data-bs-toggle="modal" data-bs-target=`#modalEditar-${pub.idPublication}`) 📝 Editar publicación
                                                li
                                                    a.dropdown-item.text-danger(href=`/post/delete/${pub.idPublication}`) ❌ Eliminar
                                            else
                                                li
                                                    a.dropdown-item.text-danger(href=`/post/report/${pub.idPublication}`) 🚩 Denunciar
                                            
                            .card-body.d-flex.flex-column
                                h4.card-title #{pub.title}
                                if pub.description
                                    p.card-text #{pub.description}

                                if pub.Tags && pub.Tags.length > 0
                                    .d-flex.flex-wrap.gap-1.mb-2
                                        each tag in pub.Tags
                                            span.badge.bg-secondary ##{tag.name}
                                if pub.Images.length === 1
                                    img.img-fluid.w-100(
                                        src=`data:image/jpeg;base64,${pub.Images[0].image.toString('base64')}`
                                        style="max-height: 500px; object-fit: contain;"
                                    )

                                else if pub.Images.length > 1
                                    div.carousel.slide(id=carouselId)
                                        .carousel-indicators
                                            each img, index in pub.Images
                                                button(
                                                    type="button"
                                                    data-bs-target=`#${carouselId}`
                                                    data-bs-slide-to=`${index}`
                                                    class=index === 0 ? 'active' : ''
                                                )
                                        .carousel-inner
                                            each img, index in pub.Images
                                                div(class=`carousel-item ${index === 0 ? 'active' : ''}`)
                                                    img.d-block.w-100(
                                                        src=`data:image/jpeg;base64,${img.image.toString('base64')}`
                                                        style="max-height: 500px; object-fit: contain;"
                                                    )
                                        button.carousel-control-prev(type="button" data-bs-target=`#${carouselId}` data-bs-slide="prev")
                                            span.carousel-control-prev-icon
                                        button.carousel-control-next(type="button" data-bs-target=`#${carouselId}` data-bs-slide="next")
                                            span.carousel-control-next-icon
                                .mt-auto
                                    .d-flex.gap-2.mt-3.justify-content-center.align-items-center
                                        if pub.idUser !== currentUser.idUser
                                            if interestedPublications[pub.idPublication]
                                                button.btn.btn-dark.interest-btn(
                                                    type="button"
                                                    data-publication=pub.idPublication
                                                    data-interested="true"
                                                )
                                                        | 💔 Ya no me interesa
                                            else
                                                button.btn.btn-outline-dark.interest-btn(
                                                    type="button"
                                                    data-publication=pub.idPublication
                                                    data-interested="false"
                                                )
                                                        | ❤️ Me interesa

                                        a.btn.btn-outline-dark.d-flex.align-items-center(href=`/comments/${pub.idPublication}`) 
                                            | 💬 Ver comentarios (#{pub.Comments ? pub.Comments.length : 0})
                                        if pub.idUser !== currentUser.idUser
                                            div.rating-container(
                                                data-publication=pub.idPublication
                                                data-image=pub.Images[0].idImage
                                            )
                                                .d-flex.gap-1
                                                    each score in [1,2,3,4,5]
                                                        button.btn.btn-outline-dark.btn-sm.rating-btn(
                                                            type="button"
                                                            data-score=score
                                                        ) #{score}
                                                if ratings[pub.idPublication]
                                                    small.text-muted.user-rating Calificaste con #{ratings[pub.idPublication]}
                                                else
                                                    small.text-muted.user-rating Sin calificar
                                    if ratingsStats[pub.idPublication].avg
                                        small.text-muted.d-flex.justify-content-center.rating-stats
                                            | ⭐ (#{ratingsStats[pub.idPublication].avg}) #{ratingsStats[pub.idPublication].total} #{ratingsStats[pub.idPublication].total === 1 ? 'voto' : 'votos'}
                                    else
                                        small.text-muted.d-flex.justify-content-center.rating-stats
                                            | Sin votos aún

                                .modal.fade(id=`modalEditar-${pub.idPublication}` tabindex="-1")
                                    .modal-dialog
                                        .modal-content
                                            .modal-header
                                                h5.modal-title Editar publicación
                                                button.btn-close(type="button" data-bs-dismiss="modal")
                                            .modal-body
                                                form(action=`/post/edit/${pub.idPublication}` method="POST")
                                                    .mb-3
                                                        label.form-label Título
                                                        input.form-control(type="text" name="title" value=pub.title)
                                                    .mb-3
                                                        label.form-label Descripción
                                                        input.form-control(type="text" name="description" value=pub.description || "")
                                                    .d-flex.justify-content-end.gap-2.mt-3
                                                        button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
                                                        button.btn.btn-primary(type="submit") Guardar

                            

                            .card-footer.text-muted(style="flex-shrink: 0;")
                                small #{new Date(pub.createdAt).toLocaleDateString('es-AR')} - #{new Date(pub.createdAt).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })}
            else
                .text-center.mt-5
                    p No hay publicaciones para mostrar.
    



block scripts
    script(src="/js/search.js")
    script(src="/js/interest.js")
    script(src="/js/comments.js")
    script(src="/js/rating.js")