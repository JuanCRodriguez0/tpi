extends ../layout.pug

block content 
    .d-flex.justify-content-center.align-items-center(style="min-height: 100vh;")
      .card.p-4(style="width: 400px;")
        h1.text-center.mb-4 Nueva publicación

        if alert
          .alert.alert-danger.text-center #{alert.text}

        form(action="/post/create" method="POST")
          .mb-3
            label.form-label.fs-4 Titulo
            input.form-control.border-secondary(type="text" name="title" placeholder="Titulo")

          .mb-3
            label.form-label.fs-4 Descripción
            input.form-control.border-secondary(type="text" name="description" placeholder="Descripción")

          .mb-3
            label.form-label.fs-4 Imágenes
            input.form-control.border-secondary(type="file" name="images" id="imagenes" multiple)
            #preview.d-flex.flex-wrap.gap-2.mt-2
            #imagenesContainer
            #copyrightContainer

          .mb-3 
            label.form-label.mb-0.fs-4 Etiquetas
            label.text-muted.small Ingrese las etiquetas separadas con coma
            input.form-control.border-secondary(
              type="text" 
              id="inputEtiqueta"
              placeholder="Paisaje,montañas,arboles..."
            )
            .d-flex.flex-wrap.gap-2.mt-2
              input(type="hidden" name="etiquetas" id="etiquetasHidden")

          .d-flex.justify-content-center.gap-3.mt-3
            button.btn.btn-dark(type="submit") Publicar
            a.btn.btn-dark(href="/home") Cancelar

block scripts
    script.
        document.querySelector('form').addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && e.target.type !== 'submit') {
                e.preventDefault()
            }
        })

        document.getElementById('imagenes').addEventListener('change', (e) => {
            const archivos = Array.from(e.target.files)
            const container = document.getElementById('imagenesContainer')
            const copyrightContainer = document.getElementById('copyrightContainer')

            container.innerHTML = ''
            copyrightContainer.innerHTML = ''

            archivos.forEach((archivo, index) => {
                const reader = new FileReader()
                reader.onload = (event) => {
                    const base64 = event.target.result

                    const input = document.createElement('input')
                    input.type = 'hidden'
                    input.name = 'imagenesBase64'
                    input.value = base64
                    container.appendChild(input)

                    const section = document.createElement('div')
                    section.className = 'mb-4 border rounded p-3'
                    section.innerHTML = `
                        <p class="fw-bold mb-2">¿Su imagen tiene Copyright?</p>
                        <div class="d-flex justify-content-center mb-3">
                            <img src="${base64}" style="max-height: 200px; max-width: 100%; object-fit: contain; border-radius: 8px;">
                        </div>
                        <select class="form-select border-secondary mb-2" name="copyright" data-index="${index}">
                            <option value="" disabled selected>Seleccionar</option>
                            <option value="false">Sin Copyright</option>
                            <option value="true">Con Copyright</option>
                        </select>
                        <div id="marcaAgua-${index}" style="display:none;">
                            <label class="form-label">Texto de marca de agua</label>
                            <input class="form-control border-secondary" type="text" name="watermark" placeholder="Ej: © Juan Cruz 2025">
                        </div>
                    `
                    copyrightContainer.appendChild(section)

                    section.querySelector('select').addEventListener('change', function() {
                        document.getElementById(`marcaAgua-${index}`).style.display = 
                            this.value === 'true' ? 'block' : 'none'
                    })
                }
                reader.readAsDataURL(archivo)
            })
        })

        document.querySelector('form').addEventListener('submit', function() {
            document.getElementById('etiquetasHidden').value = document.getElementById('inputEtiqueta').value;
        });